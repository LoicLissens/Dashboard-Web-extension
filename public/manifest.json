{
  "manifest_version": 3,
  "name": "My Extension",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "dashboard@loiclissens",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {},
  "background": {
    "service_worker": "build/background.js",
    "scripts": [
      "build/background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://calendar.google.com/*",
    "https://calendar.proton.me/*"
  ]
}
