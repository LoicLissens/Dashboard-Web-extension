{
  "name": "svelte-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm-run-all build:css build:js",
    "build:css": "tailwindcss -i src/app.css -o public/build/tailwind.css --minify",
    "build:js": "rollup -c",
    "dev": "npm-run-all --parallel dev:css dev:js",
    "dev:css": "tailwindcss -i src/app.css -o public/build/tailwind.css --watch",
    "dev:js": "rollup -c -w",
    "start": "sirv public --no-clear",
    "typecheck": "tsc --noEmit",
    "validate": "svelte-check --fail-on-warnings"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^2.4.2",
    "@rollup/plugin-typescript": "^8.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/webextension-polyfill": "^0.12.6",
    "daisyui": "^5.7.32",
    "dotenv": "^8.2.0",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.3",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.3",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^4.2.20",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.0.0",
    "typescript": "^5.9.3",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "@rollup/plugin-json": "^4.1.0",
    "axios": "^1.8.4",
    "highlight.js": "^11.11.1",
    "ical.js": "^2.2.1",
    "sirv-cli": "^1.0.0",
    "zod": "^3.24.2"
  }
}
